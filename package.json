{
  "name": "chogos",
  "version": "0.1.0",
  "private": true,
  "description": "chogOS, a shared civilization for Chog Genesis citizens on Monad.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:contracts": "tsx scripts/verify-contracts.ts",
    "discover:treasury": "tsx scripts/discover-treasury.ts",
    "world:init": "tsx scripts/world-init.ts",
    "world:expand": "tsx scripts/world-expand.ts",
    "world:runner": "tsx scripts/world-runner.ts",
    "ai:runner": "tsx scripts/ai-runner.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "world:admin": "tsx scripts/world-admin.ts",
    "world:speed-report": "tsx scripts/world-speed-report.ts",
    "verify:cutover": "tsx scripts/verify-cutover.ts",
    "verify:snapshot": "tsx scripts/verify-batch.ts --snapshot",
    "verify:batch": "tsx scripts/verify-batch.ts",
    "verify:anchor": "tsx scripts/verify-anchor.ts",
    "verify:contracts-local": "forge test --root contracts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18"
  }
