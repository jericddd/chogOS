# Monad. 143 is mainnet. 10143 is testnet.
# The public RPC is rate-limited. Override it with your own endpoint for development.
# Fork tests: forge test --root contracts --fork-url "$MONAD_RPC_URL" --match-contract GenesisMainnetFork
# Never put a wallet private key, mnemonic, or Foundry keystore password in this file or in Supabase.
MONAD_CHAIN_ID=143
MONAD_RPC_URL=https://rpc.monad.xyz

# Optional address overrides. The defaults are the addresses checked in docs/contracts.md.
CHOG_NFT_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763
CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777

# Existing ChogTreasury NFT wallet. This is not the economic treasury and not a $CHOG balance.
CHOG_TREASURY_ADDRESS=0x84113421A8a564b594ee9Ae78c875310332d7023

# Comparison figure only. The app does not invent token ids to reach this number.
EXPECTED_FOUNDING_COUNT=59

# Metadata gateway. Only ipfs:// URIs are rewritten onto this host.
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Optional NFT indexer. none uses the collection's tokensOfOwner, then ownerOf.
# alchemy: set NFT_INDEXER_API_KEY. custom: set NFT_INDEXER_URL to an https endpoint
# that returns { "tokenIds": ["1", "2"] } for ?owner=&contract=
# Indexer failures never replace ids the contract already verified.
NFT_INDEXER=none
NFT_INDEXER_API_KEY=
NFT_INDEXER_URL=

# Optional. When set, the treasury button is hidden and POST /api/sync/genesis
# requires Authorization: Bearer <SYNC_SECRET>.
SYNC_SECRET=

# Optional. When set, POST /api/treasury/configure and POST /api/treasury/funding
# require Authorization: Bearer <TREASURY_ADMIN_SECRET>. When unset, those routes refuse.
# This is not a wallet key. Leave it unset until an administrator is ready to record a real address.
TREASURY_ADMIN_SECRET=

# Supabase. Required to persist founding citizens and community enrollment.
# Use the project https URL, or http://127.0.0.1 / http://localhost for a local PostgREST.
# Other http URLs are rejected. Never commit a real service role key. It bypasses row level security.
SUPABASE_URL=
# Optional. Public by design. When set, the browser joins the read-only Realtime
# broadcast channel chogos-world for world updates. It has no table grants.
# Without it the world page polls the server every 4 seconds.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 world. The speed in world_state is authoritative; WORLD_SPEED only sets
# the starting value for npm run world:init (demo = 60, calm = 20, or 1 to 1000).
WORLD_SPEED=
# Interval for npm run world:runner, the fallback when pg_cron is unavailable.
WORLD_TICK_SECONDS=5
# Optional. When set, POST /api/world/tick requires Authorization: Bearer <WORLD_RUNNER_SECRET>.
# When unset, that route refuses. It can only advance the simulation.
WORLD_RUNNER_SECRET=

# AI provider used only when server code calls getAiProvider().
# Supported values: none, gemini, openai, anthropic, ajax.
# ajax refuses until a verified endpoint and request format exist. No URL is assumed.
# gemini defaults to gemini-3.8-flash. Credentials alone do not start the mind.
AI_PROVIDER=none
AI_API_KEY=
# Optional alias. If AI_API_KEY is blank, GEMINI_API_KEY is used.
GEMINI_API_KEY=
AI_MODEL=
# Optional full endpoint override. Leave blank for the provider default.
AI_BASE_URL=
# Cloud runner. GET/POST /api/ai/run stays closed until a secret is set.
# AI_RUNNER_ENABLED must be the exact string true. The world keeps ticking if the mind is off.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Use the same value as AI_RUNNER_SECRET.
AI_RUNNER_SECRET=
CRON_SECRET=
AI_RUNNER_ENABLED=false
# Each poke keeps deciding until the invocation deadline, the hourly cap, or the daily cap.
# 500 a day matches the free Flash-Lite allowance. A Gemini quota error stops the mind sooner
# and does not turn on billing. Vercel Hobby cron stays once a day; GitHub pokes more often.
AI_DECISIONS_PER_RUN=8
AI_MIN_DECISION_INTERVAL_SECONDS=300
AI_MAX_DECISIONS_PER_HOUR=60
AI_MAX_DECISIONS_PER_DAY=500
AI_MAX_PROMPT_CHARS=8000
# maxOutputTokens includes Gemini thinking tokens. 512 was too small and the call sat until timeout.
AI_MAX_OUTPUT_TOKENS=2048
# One Gemini call. The poke stops starting calls at 4 minutes, before the 300s function limit.
AI_REQUEST_TIMEOUT_MS=40000
# Fallback process interval when calling npm run ai:runner. Does not tick the world.
AI_RUNNER_SECONDS=180

# Phase 3.75 verification. Leave unset until EventAnchor is actually deployed.
# These are not wallet keys. verify:anchor never broadcasts a transaction.
EVENT_ANCHOR_ADDRESS=
EVENT_ANCHOR_CHAIN_ID=

# Phase 6b ChogBank. Leave unset. Predicted factory is not deployed.
# Never put a treasury, relayer, or Foundry private key here.
CITIZEN_ACCOUNT_FACTORY_ADDRESS=
CITIZEN_ACCOUNT_FACTORY_CODE_VERIFIED=false
CHOG_BANK_RELAYER_ENABLED=false
CHOG_BANK_MAX_ACTIVATION_WEI=500000000000000000
CHOG_BANK_MAX_TX_WEI=100000000000000000
CHOG_BANK_MAX_DAILY_GAS_WEI=1000000000000000000
CHOG_BANK_MAX_TREASURY_EXPOSURE_WEI=5000000000000000000

# Phase 6c transfer watcher. Leave disabled. This does not start a scan.
# Never put a relayer or treasury private key here.
CHOG_WATCHER_ENABLED=false
CHOG_WATCHER_MAX_LAG_BLOCKS=20

# Phase 6d. Leave disabled. npm run watcher:run exits without an RPC call until
# CHOG_WATCHER_ENABLED=true. Apply supabase/migrations/20261019130000_phase6d_watcher_durable.sql
# by hand before the first enabled run. CHOG_WATCHER_LOOP=true keeps a process alive.
# CHOG_WATCHER_BACKFILL_FROM is the first block to scan when the cursor is empty.
# Do not set it to zero unless you intend to read the whole chain.
# CHOG_BANK_GAS_ADDRESS is the public gas-paying address only.
# CHOG_BANK_ASSET_ADDRESS is the public asset-control address and must be different.
# Never put a private key, mnemonic, or KMS credential in this file.
CHOG_WATCHER_SECONDS=60
CHOG_WATCHER_MAX_STALE_MS=120000
CHOG_WATCHER_BACKFILL_FROM=
CHOG_BANK_GAS_ADDRESS=
CHOG_BANK_ASSET_ADDRESS=
CHOG_BANK_OBSERVATION_MAX_AGE_MS=120000

# Phase 7. Leave the economic treasury unset until a public address is chosen.
# Do not put the ChogTreasury NFT wallet in CHOG_BANK_ASSET_ADDRESS.
# $CHOG limits are integer base units. Unset means 0, which blocks token spending.
# ECONOMY_PROTOCOL_ALLOWLIST stays empty until a target and its selectors are reviewed.
# The application does not sign, broadcast, or enable the relayer from these values.
# CHOG_BANK_MAX_CITIZEN_CAPITAL_WEI=
# CHOG_BANK_MAX_BUSINESS_CAPITAL_WEI=
# CHOG_BANK_MAX_CHOG_PER_TX_RAW=
# CHOG_BANK_MAX_CITIZEN_CHOG_RAW=
# CHOG_BANK_MAX_BUSINESS_CHOG_RAW=
# ECONOMY_PROTOCOL_ALLOWLIST=
